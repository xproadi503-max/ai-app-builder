# GitHub OAuth App se milega (steps README me hain)
GH_CLIENT_ID=your_github_client_id
GH_CLIENT_SECRET=your_github_client_secret

# NextAuth ke liye random secret (koi bhi random text chalega)
NEXTAUTH_SECRET=random_long_secret_string_yaha_daalo
NEXTAUTH_URL=http://localhost:3000

# OpenRouter se milega (free, card nahi chahiye, DeepSeek model) -> https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
